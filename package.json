{
  "name": "sdet-showcase",
  "version": "0.1.0",
  "description": "SDET portfolio project: Playwright + strict TypeScript test automation.",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate:spec": "node scripts/fetch-spec.mjs",
    "generate:types": "pnpm dlx --package openapi-typescript@7.13.0 --package typescript@5.9.3 openapi-typescript spec/openapi.json -o clients/generated/schema.ts",
    "generate:api": "pnpm generate:spec && pnpm generate:types",
    "browsers:install": "playwright install chromium",
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=ui",
    "test:algo": "node --test \"algo/**/*.test.ts\"",
    "test:docker": "sh scripts/test-docker.sh test",
    "test:docker:api": "sh scripts/test-docker.sh test:api",
    "test:docker:ui": "sh scripts/test-docker.sh test:ui",
    "report": "playwright show-report",
    "report:allure": "allure generate allure-results -o allure-report --clean",
    "report:allure:open": "allure open allure-report"
  },
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.11.2",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "allure": "^3.21.0",
    "allure-playwright": "^3.13.0",
    "typescript": "^7.0.2"
  }
}
